# Normalize text files without changing Windows checkout compatibility.
* text=auto eol=lf

# Source and configuration files are always text.
*.php text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.neon text eol=lf

# Binary assets must not be normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.phar binary

# Development-only material is excluded from source archives.
/.github export-ignore
/tests export-ignore
/engineering/reviews export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.php export-ignore
/phpstan.neon export-ignore
/phpunit.xml export-ignore
/CONTRIBUTING.md export-ignore
/CODE_OF_CONDUCT.md export-ignore
/SECURITY.md export-ignore
/SUPPORT.md export-ignore
/GOVERNANCE.md export-ignore

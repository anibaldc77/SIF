{
  "name": "sif/runtime-foundation",
  "description": "Runtime foundation for the SIF framework.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.12"
  },
  "autoload": {
    "psr-4": {
      "Sif\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sif\\Foundation\\Tests\\": "tests/Foundation/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml"
  },
  "minimum-stability": "stable"
}

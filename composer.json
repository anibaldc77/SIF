{
  "name": "sif/runtime-foundation",
  "description": "Runtime foundation for the SIF framework.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.12",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "autoload": {
    "psr-4": {
      "Sif\\Foundation\\": "src/Foundation/",
      "Sif\\Support\\": "tools/builder/src/Support/",
      "Sif\\Builder\\FileSystem\\": "tools/builder/src/FileSystem/",
      "Sif\\Builder\\Metadata\\": "tools/builder/src/Metadata/",
      "Sif\\Builder\\Repository\\": "tools/builder/src/Repository/",
      "Sif\\Builder\\Reference\\": "tools/builder/src/Reference/",
      "Sif\\Builder\\Application\\": "tools/builder/src/Application/",
      "Sif\\Builder\\Engine\\": "tools/builder/src/Engine/",
      "Sif\\Builder\\Cli\\": "tools/builder/src/Cli/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sif\\Foundation\\Tests\\": "tests/Foundation/",
      "Sif\\Support\\Tests\\": "tools/builder/tests/Support/",
      "Sif\\Builder\\FileSystem\\Tests\\": "tools/builder/tests/",
      "Sif\\Builder\\Tests\\": "tools/builder/tests/",
      "Sif\\Builder\\Tests\\Cli\\": "tools/builder/tests/Cli/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit --configuration phpunit.xml",
    "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
    "style": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --diff",
    "style:check": "@php vendor/bin/php-cs-fixer fix --dry-run --config=.php-cs-fixer.php --diff",
    "quality": [
      "@composer validate --strict --no-check-publish",
      "@test",
      "@analyse",
      "@style:check"
    ]
  },
  "minimum-stability": "stable",
  "config": {
    "platform": {
      "php": "8.2.32"
    },
    "sort-packages": true
  }
}
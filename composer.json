{
  "name": "sif/runtime-foundation",
  "description": "Runtime foundation for the SIF framework.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.12 || ^2.0",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "autoload": {
    "psr-4": {
      "Sif\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sif\\Foundation\\Tests\\": "tests/Foundation/"
    }
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit --configuration phpunit.xml",
    "analyse": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
    "style": "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --diff",
    "style:check": "@php vendor/bin/php-cs-fixer fix --dry-run --config=.php-cs-fixer.php --diff",
    "quality": ["@composer validate --strict --no-check-publish", "@test", "@analyse", "@style:check"]
  },
  "minimum-stability": "stable",
  "config": {
    "platform": {
      "php": "8.2.32"
    },
    "sort-packages": true
  }
}
